# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./nanoex.db
# Postgres example: postgresql+asyncpg://nanoex:nanoex@localhost:5432/nanoex
AUTO_CREATE_TABLES=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_AUTH=5/minute

# Optional first admin account (created at startup if missing)
ADMIN_EMAIL=admin@nanoex.in
ADMIN_PASSWORD=ChangeMe123

# Paper wallet
INITIAL_WALLET_BALANCE=500000
MAX_TOPUP_AMOUNT=1000000
MAX_DAILY_TOPUPS=5

# Market data: synthetic (default, offline) or yfinance (pip install yfinance)
MARKET_PROVIDER=synthetic
TICK_INTERVAL_MS=500
SIM_SEED=42

# Arbitrage simulation
ARB_MIN_LATENCY_MS=20
ARB_MAX_LATENCY_MS=150
ARB_LEG_FAILURE_PROB=0.05
